<Window x:Class="EasyUnpack.App.PasswordVaultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyUnpack - 密码库"
        Width="880" Height="620" MinWidth="720" MinHeight="520"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="密码库" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="优先级 1 的密码会最先尝试" Style="{StaticResource SecondaryTextStyle}" Margin="0,3,0,0" />
            </StackPanel>
            <Button x:Name="RevealAllButton" Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="&#xE890;"
                    ToolTip="显示列表中的密码" Click="RevealAll_Click" Margin="0,0,8,0" />
            <Button Grid.Column="2" x:Name="NewEntryButton" Style="{StaticResource ActionButtonStyle}" Click="NewEntry_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" />
                    <TextBlock Text="新建密码" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource SurfaceBorderStyle}" Margin="0,18,0,16" Padding="1">
            <DataGrid x:Name="EntryList" Style="{StaticResource ModernDataGridStyle}" IsReadOnly="True"
                      AllowDrop="True" SelectionChanged="EntryList_SelectionChanged"
                      PreviewMouseLeftButtonDown="EntryList_PreviewMouseLeftButtonDown"
                      MouseMove="EntryList_MouseMove" DragOver="EntryList_DragOver" Drop="EntryList_Drop">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="42">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="⋮⋮" Tag="PasswordDragHandle" FontSize="16" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="拖动调整优先级" Cursor="SizeAll" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="优先级" Binding="{Binding Priority}" Width="72" />
                    <DataGridTextColumn Header="备注" Binding="{Binding Label}" Width="*" />
                    <DataGridTextColumn Header="密码" Binding="{Binding MaskedPassword}" Width="160" />
                    <DataGridTextColumn Header="成功次数" Binding="{Binding SuccessCount}" Width="90" />
                    <DataGridTextColumn Header="最近成功" Binding="{Binding LastSuccessfulText}" Width="170" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource SurfaceBorderStyle}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="备注" Style="{StaticResource DialogLabelStyle}" />
                <TextBlock Grid.Column="1" Text="密码" Style="{StaticResource DialogLabelStyle}" Margin="12,0,0,6" />

                <TextBox x:Name="LabelInput" Grid.Row="1" MinHeight="36" VerticalContentAlignment="Center" />
                <Grid Grid.Row="1" Grid.Column="1" Margin="12,0,8,0">
                    <PasswordBox x:Name="PasswordInput" MinHeight="36" VerticalContentAlignment="Center" PasswordChanged="PasswordInput_PasswordChanged" />
                    <TextBox x:Name="RevealedPasswordInput" MinHeight="36" VerticalContentAlignment="Center"
                             Visibility="Collapsed" TextChanged="RevealedPasswordInput_TextChanged" />
                </Grid>
                <Button x:Name="RevealButton" Grid.Row="1" Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                        Content="&#xE890;" ToolTip="显示密码" Click="Reveal_Click" Margin="0,0,8,0" />
                <Button x:Name="SaveEntryButton" Grid.Row="1" Grid.Column="3" Style="{StaticResource ActionButtonStyle}"
                        Content="添加密码" Click="SaveEntry_Click" />

                <TextBlock x:Name="ValidationText" Grid.Row="2" Grid.ColumnSpan="4" Foreground="{StaticResource ErrorBrush}"
                           Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="DeleteButton" Style="{StaticResource ActionButtonStyle}" Click="Delete_Click" IsEnabled="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" />
                    <TextBlock Text="删除" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" x:Name="SetProtectionButton" Style="{StaticResource ActionButtonStyle}"
                    Margin="8,0,0,0" Content="设置主密码" Click="SetProtection_Click" />
            <Button Grid.Column="2" x:Name="RemoveProtectionButton" Style="{StaticResource ActionButtonStyle}"
                    Margin="8,0,0,0" Content="移除保护" Click="RemoveProtection_Click" Visibility="Collapsed" />
            <Button Grid.Column="4" Style="{StaticResource ActionButtonStyle}" Content="关闭" IsCancel="True" />
        </Grid>
    </Grid>
</Window>
