<Window x:Class="EasyUnpack.App.MasterPasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="解锁密码库" Width="440" Height="260" ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="解锁密码库" Style="{StaticResource PageTitleTextStyle}" FontSize="20" />
        <TextBlock Grid.Row="1" Text="主密码" Style="{StaticResource DialogLabelStyle}" Margin="0,16,0,6" />
        <PasswordBox x:Name="PasswordInput" Grid.Row="2" MinHeight="36" VerticalContentAlignment="Center" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Style="{StaticResource ActionButtonStyle}" IsCancel="True" />
            <Button Content="解锁" Style="{StaticResource ActionButtonStyle}" Margin="8,0,0,0" IsDefault="True" Click="Unlock_Click" />
        </StackPanel>
    </Grid>
</Window>
