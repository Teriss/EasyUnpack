<Window x:Class="EasyUnpack.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyUnpack - 引擎设置"
        Width="900" Height="620" MinWidth="720" MinHeight="500"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="解压引擎" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="配置工具路径和自动解压时优先使用的引擎" Style="{StaticResource SecondaryTextStyle}" Margin="0,3,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource SurfaceBorderStyle}" Margin="0,18,0,16" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="工具" Style="{StaticResource DialogLabelStyle}" />
                <TextBlock Grid.Column="1" Text="首选引擎" Style="{StaticResource DialogLabelStyle}" Margin="12,0,0,6" />
                <TextBlock Grid.Column="2" Text="可执行文件路径" Style="{StaticResource DialogLabelStyle}" Margin="12,0,0,6" />

                <ComboBox x:Name="EngineKindPicker" Grid.Row="1" MinHeight="36" VerticalContentAlignment="Center" />
                <ComboBox x:Name="PreferredEnginePicker" Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" MinHeight="36"
                          VerticalContentAlignment="Center" SelectionChanged="PreferredEnginePicker_SelectionChanged" />
                <TextBox x:Name="ManualPathBox" Grid.Row="1" Grid.Column="2" Margin="12,0,8,0" MinHeight="36"
                         VerticalContentAlignment="Center" />
                <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource ActionButtonStyle}" Click="Browse_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" />
                        <TextBlock Text="浏览" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{StaticResource ActionButtonStyle}" Click="SavePath_Click" Content="保存路径" />
                    <Button Style="{StaticResource ActionButtonStyle}" Click="RemovePath_Click" Content="移除路径" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="已检测到的工具" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Click="Refresh_Click" ToolTip="重新扫描可用工具">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" />
                    <TextBlock Text="重新扫描" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource SurfaceBorderStyle}" Padding="1">
            <DataGrid x:Name="EngineList" Style="{StaticResource ModernDataGridStyle}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="引擎" Binding="{Binding DisplayName}" Width="140" />
                    <DataGridTextColumn Header="检测来源" Binding="{Binding DetectionSource}" Width="190" />
                    <DataGridTemplateColumn Header="可执行文件" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ExecutablePath}" ToolTip="{Binding ExecutablePath}" Style="{StaticResource PathCellTextStyle}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource ActionButtonStyle}" Click="OpenPasswordVault_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8D7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" />
                    <TextBlock Text="密码库" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource ActionButtonStyle}" Content="关闭" IsCancel="True" />
        </Grid>
    </Grid>
</Window>
