<Window x:Class="EasyUnpack.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyUnpack - 解压任务"
        Width="1100" Height="700" MinWidth="840" MinHeight="520"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
        Loaded="Window_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="42" Height="42" CornerRadius="8"
                    Background="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}">
                <TextBlock Text="&#xE7B8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                <TextBlock Text="EasyUnpack" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="自动识别并解压右键选择的文件" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0" />
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0"
                    Click="OpenPasswordVault_Click" ToolTip="管理密码和尝试优先级">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8D7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" />
                    <TextBlock Text="密码库" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource ActionButtonStyle}" Click="OpenSettings_Click" ToolTip="配置解压引擎">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" />
                    <TextBlock Text="引擎设置" />
                </StackPanel>
            </Button>
        </Grid>

        <Border x:Name="StatusPanel" Grid.Row="1" Margin="0,20,0,12" Padding="12,10"
                Style="{StaticResource SurfaceBorderStyle}" BorderThickness="4,1,1,1" BorderBrush="{StaticResource InfoBrush}">
            <DockPanel LastChildFill="True">
                <ProgressBar x:Name="ActivityProgress" Width="72" Height="8" Margin="0,0,10,0"
                             IsIndeterminate="True" VerticalAlignment="Center" Visibility="Visible" />
                <TextBlock x:Name="StatusIcon" Text="&#xE895;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="16" Foreground="{StaticResource InfoBrush}" Margin="0,0,10,0" VerticalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <RotateTransform />
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="StatusText" Text="正在扫描文件…" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource SurfaceBorderStyle}" Padding="12,8" Margin="0,0,0,16">
            <DockPanel LastChildFill="True">
                <TextBlock Text="&#xE950;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" Margin="0,0,8,0" />
                <TextBlock x:Name="EngineInfoText" Text="正在检测解压引擎…" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="解压任务" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,8" />

        <Border Grid.Row="4" Style="{StaticResource SurfaceBorderStyle}" Padding="1">
            <DataGrid x:Name="CandidateGrid" Style="{StaticResource ModernDataGridStyle}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="名称" Binding="{Binding LogicalName}" Width="160" />
                    <DataGridTextColumn Header="格式" Binding="{Binding Format}" Width="85" />
                    <DataGridTemplateColumn Header="源文件" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" Style="{StaticResource PathCellTextStyle}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="输出目录" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding OutputDirectory}" ToolTip="{Binding OutputDirectory}" Style="{StaticResource PathCellTextStyle}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="进度" Width="190">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <ProgressBar Height="6" Minimum="0" Maximum="100"
                                                 Value="{Binding ProgressPercent}"
                                                 IsIndeterminate="{Binding IsProgressIndeterminate}" />
                                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource PathCellTextStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="175" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
